@using BenBowenBlog.Web.Site
@using Microsoft.Extensions.Options
@inject IOptions<SiteOptions> SiteOptions

@* Static (no interactivity), so screen-size switching is CSS only: MudBlazor's d-* display classes at the md
   breakpoint (960px). The mobile menu is a native <details> element; wwwroot/js/menu.js adds closing on an outside
   click, Escape, or choosing a link. *@

<nav class="d-none d-md-flex align-center" aria-label="Main">
    @foreach (var link in Links) {
        <MudButton Href="@link.Href" Color="Color.Inherit" Variant="Variant.Text"
                   StartIcon="@link.Icon">@link.Text</MudButton>
    }

    @if (Socials.Count > 0) {
        <span class="top-nav-divider" aria-hidden="true"></span>
        @foreach (var social in Socials) {
            <MudIconButton Href="@social.Url" Target="_blank" rel="noopener" Icon="@social.Icon" Color="Color.Inherit"
                           aria-label="@social.Name" title="@social.Name"/>
        }
    }
</nav>

<details class="mobile-menu d-md-none">
    <summary aria-label="Menu">
        <MudIcon Icon="@Icons.Material.Filled.Menu"/>
    </summary>
    <div class="mobile-menu-panel mud-elevation-8">
        <nav aria-label="Main">
            @foreach (var link in Links) {
                <a class="mobile-menu-link" href="@link.Href">
                    <MudIcon Icon="@link.Icon" Size="Size.Small"/>
                    <span>@link.Text</span>
                </a>
            }
        </nav>

        @if (Socials.Count > 0) {
            <div class="mobile-menu-social">
                @foreach (var social in Socials) {
                    <MudIconButton Href="@social.Url" Target="_blank" rel="noopener" Icon="@social.Icon"
                                   aria-label="@social.Name" title="@social.Name"/>
                }
            </div>
        }
    </div>
</details>

@code {
    private static readonly NavItem[] Links = [
        new("Tags", "/tags", Icons.Material.Filled.LocalOffer),
        new("Categories", "/categories", Icons.Material.Filled.Category),
        new("About", "/about", Icons.Material.Filled.Info),
        new("Subscribe", "/feed.xml", Icons.Material.Filled.RssFeed)
    ];

    private List<SocialLink> Socials =>
        new SocialLink?[] {
                Social("GitHub", SiteOptions.Value.GitHubUrl, Icons.Custom.Brands.GitHub),
                Social("LinkedIn", SiteOptions.Value.LinkedInUrl, Icons.Custom.Brands.LinkedIn),
                Social("Bluesky", SiteOptions.Value.BlueskyUrl, BrandIcons.Bluesky)
            }
            .OfType<SocialLink>()
            .ToList();

    private static SocialLink? Social(string name, string? url, string icon) =>
        String.IsNullOrWhiteSpace(url) ? null : new SocialLink(name, url, icon);

    private record NavItem(string Text, string Href, string Icon);

    private record SocialLink(string Name, string Url, string Icon);
}
