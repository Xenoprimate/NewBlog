@page "/admin/posts"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authentication
@inject BlogDbContext Db
@inject NavigationManager Navigation

<PageTitle>Posts</PageTitle>

<AdminNav />

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4" HtmlTag="h1">Posts</MudText>
    <MudButton Href="/admin/posts/new" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add">New post</MudButton>
</MudStack>

@if (posts.Count == 0)
{
    <MudText>No posts yet.</MudText>
}
else
{
    <MudSimpleTable Hover="true" Outlined="true">
        <thead>
            <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Status</th>
                <th>Updated</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var post in posts)
            {
                <tr>
                    <td>@post.Title<br /><MudText Typo="Typo.caption" Class="mud-text-secondary"><code>@post.Slug</code></MudText></td>
                    <td>@post.CategoryName</td>
                    <td>@(post.PublishedAt is { } published ? $"Published {published:d MMM yyyy}" : "Draft")</td>
                    <td>@post.UpdatedAt.ToString("d MMM yyyy HH:mm")</td>
                    <td>
                        <MudLink Href="@($"/admin/posts/{post.Id}")">Edit</MudLink>
                        &middot;
                        <MudLink Href="@($"/post/{post.Slug}")">View</MudLink>
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<form id="lock" method="post" @formname="lock" @onsubmit="LockAsync" class="mt-6">
    <AntiforgeryToken />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Lock">Lock</MudButton>
</form>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private List<PostRow> posts = [];

    protected override async Task OnInitializedAsync()
    {
        posts = await Db.Posts
            .AsNoTracking()
            .OrderByDescending(p => p.UpdatedAt)
            .Select(p => new PostRow(p.Id, p.Title, p.Slug, p.Category!.Name, p.PublishedAt, p.UpdatedAt))
            .ToListAsync();
    }

    private async Task LockAsync()
    {
        await HttpContext.SignOutAsync();
        Navigation.NavigateTo("/");
    }

    private record PostRow(int Id, string Title, string Slug, string CategoryName, DateTimeOffset? PublishedAt, DateTimeOffset UpdatedAt);
}
