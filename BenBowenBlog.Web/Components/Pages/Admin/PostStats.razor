@page "/admin/posts/{Id:int}/stats"
@attribute [Authorize]
@using BenBowenBlog.Web.Metrics
@inject BlogDbContext Db
@inject NavigationManager Navigation

@if (post is not null)
{
    <PageTitle>Stats: @post.Title</PageTitle>

    <AdminNav />

    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-1">@post.Title</MudText>
    <MudText Typo="Typo.body2" Class="mb-6">
        <MudLink Href="@($"/admin/posts/{post.Id}")">Edit</MudLink> &middot;
        <MudLink Href="@($"/post/{post.Slug}")">View</MudLink> &middot;
        <span class="mud-text-secondary">Days are UTC. Visitors are counted once per post per day.</span>
    </MudText>

    @if (allTime.Views == 0)
    {
        <MudText>No visits recorded yet.</MudText>
    }
    else
    {
        <div class="stat-cards mb-6">
            @foreach (var (label, totals) in new[] { ("Last 7 days", last7), ("Last 30 days", last30), ("All time", allTime) })
            {
                <MudPaper Outlined="true" Class="stat-card">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@label</MudText>
                    <div class="stat-card-values">
                        <span><strong>@totals.Views.ToString("N0")</strong> views</span>
                        <span><strong>@totals.Visitors.ToString("N0")</strong> visitors</span>
                    </div>
                </MudPaper>
            }
        </div>

        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Daily, last 30 days</MudText>
        <div class="trend-legend mb-2">
            <span class="trend-key trend-key-views"></span> Views
            <span class="trend-key trend-key-visitors"></span> Visitors
        </div>
        <div class="trend-chart mb-8" role="img" aria-label="Views and visitors per day over the last 30 days">
            @foreach (var day in days)
            {
                <div class="trend-day" title="@($"{day.Date:ddd d MMM}: {day.Views} views, {day.Visitors} visitors")">
                    <div class="trend-bars">
                        <span class="trend-bar trend-bar-views" style="height: @Percent(day.Views)%"></span>
                        <span class="trend-bar trend-bar-visitors" style="height: @Percent(day.Visitors)%"></span>
                    </div>
                    <span class="trend-label">@(day.Date.Day == 1 || day == days[0] || day.Date.DayOfWeek == DayOfWeek.Monday ? day.Date.ToString("d MMM") : "")</span>
                </div>
            }
        </div>

        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Top sources, last 30 days</MudText>
        @if (sources.Count == 0)
        {
            <MudText>No visits in the last 30 days.</MudText>
        }
        else
        {
            <MudSimpleTable Outlined="true" Dense="true">
                <thead>
                    <tr>
                        <th>Source</th>
                        <th class="text-right">Visitors</th>
                        <th class="text-right">Views</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var source in sources)
                    {
                        <tr>
                            <td>
                                @if (source.Source.StartsWith(VisitClassifier.CampaignPrefix, StringComparison.Ordinal))
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">campaign</MudChip>
                                    @source.Source[VisitClassifier.CampaignPrefix.Length..]
                                }
                                else
                                {
                                    @source.Source
                                }
                            </td>
                            <td class="text-right">@source.Visitors.ToString("N0")</td>
                            <td class="text-right">@source.Views.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private const int TrendDays = 30;
    private const int TopSourceCount = 20;

    [Parameter]
    public int Id { get; set; }

    private PostInfo? post;
    private Totals allTime = new(0, 0);
    private Totals last7 = new(0, 0);
    private Totals last30 = new(0, 0);
    private List<DayStats> days = [];
    private List<SourceStats> sources = [];
    private int max = 1;

    protected override async Task OnInitializedAsync()
    {
        post = await Db.Posts.AsNoTracking().Where(p => p.Id == Id).Select(p => new PostInfo(p.Id, p.Title, p.Slug)).FirstOrDefaultAsync();

        if (post is null)
        {
            Navigation.NotFound();
            return;
        }

        var visits = Db.PostVisits.AsNoTracking().Where(v => v.PostId == Id);
        var today = DateOnly.FromDateTime(DateTime.UtcNow);
        var since = today.AddDays(-(TrendDays - 1));

        allTime = new Totals(await visits.SumAsync(v => v.Views), await visits.CountAsync());

        var daily = await visits
            .Where(v => v.Date >= since)
            .GroupBy(v => v.Date)
            .Select(g => new DayStats(g.Key, g.Sum(v => v.Views), g.Count()))
            .ToDictionaryAsync(d => d.Date);

        // Every day gets a slot, so quiet days show as gaps in the chart.
        days = Enumerable.Range(0, TrendDays)
            .Select(offset => since.AddDays(offset))
            .Select(date => daily.GetValueOrDefault(date) ?? new DayStats(date, 0, 0))
            .ToList();

        last30 = new Totals(days.Sum(d => d.Views), days.Sum(d => d.Visitors));
        last7 = new Totals(days.TakeLast(7).Sum(d => d.Views), days.TakeLast(7).Sum(d => d.Visitors));
        max = Math.Max(1, days.Max(d => d.Views));

        // Sorted on an anonymous projection: EF can't translate ORDER BY on members of a record built by its constructor.
        var topSources = await visits
            .Where(v => v.Date >= since)
            .GroupBy(v => v.Source)
            .Select(g => new { Source = g.Key, Visitors = g.Count(), Views = g.Sum(v => v.Views) })
            .OrderByDescending(s => s.Visitors)
            .ThenByDescending(s => s.Views)
            .Take(TopSourceCount)
            .ToListAsync();

        sources = topSources.Select(s => new SourceStats(s.Source, s.Visitors, s.Views)).ToList();
    }

    private string Percent(int value) => (value * 100.0 / max).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private record PostInfo(int Id, string Title, string Slug);

    private record Totals(int Views, int Visitors);

    private record DayStats(DateOnly Date, int Views, int Visitors);

    private record SourceStats(string Source, int Visitors, int Views);
}
