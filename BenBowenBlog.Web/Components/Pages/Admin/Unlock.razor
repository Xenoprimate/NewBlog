@page "/admin/unlock"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AdminKeyAuthenticator AdminKeyAuthenticator
@inject NavigationManager Navigation

<PageTitle>Unlock</PageTitle>

<MudPaper Outlined="true" Class="pa-6 mx-auto" Style="max-width: 28rem">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4">Unlock</MudText>

    @* A plain input rather than MudTextField: this page is a static form post, and MudBlazor's inputs need interactivity. *@
    <EditForm Model="Input" FormName="unlock" OnSubmit="UnlockAsync">
        <label for="key" class="admin-label">Key</label>
        <InputText id="key" type="password" class="admin-input mb-4" autocomplete="current-password"
                   @bind-Value="Input!.Key"/>

        @if (error is not null) {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@error</MudAlert>
        }

        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true">
            Unlock
        </MudButton>
    </EditForm>
</MudPaper>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private UnlockInput? Input { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? error;

    protected override void OnInitialized() => Input ??= new();

    private async Task UnlockAsync() {
        switch (await AdminKeyAuthenticator.VerifyAsync(Input!.Key, HttpContext.RequestAborted)) {
            case AdminKeyResult.Valid:
                var identity = new ClaimsIdentity([new Claim(ClaimTypes.Name, "admin")], CookieAuthenticationDefaults.AuthenticationScheme);
                await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));
                Navigation.NavigateTo(IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/admin/posts");
                break;

            case AdminKeyResult.Busy:
                error = "Too many attempts, try again shortly.";
                break;

            default:
                error = "Invalid key.";
                break;
        }
    }

    // Only redirect to paths on this site, never to "//evil.example" or "/\\evil.example".
    private static bool IsLocalUrl(string? url) =>
        url is {Length: > 0} && url[0] == '/' && (url.Length == 1 || url[1] != '/' && url[1] != '\\');

    private sealed class UnlockInput {
        public string? Key { get; set; }
    }

}
